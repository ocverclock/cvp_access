[Unit]
Description=CVP Access local maintenance portal
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=CVP_USER=@CVP_USER@
Environment=CVP_RUNTIME_DIR=@PROJECT_DIR@
Environment=CVP_REPO_DIR=@REPO_DIR@
Environment=CVP_RECORDINGS_DIR=@RECORDINGS_DIR@
Environment=CVP_CONFIG_DIR=/etc/cvp-access
Environment=CVP_WEB_REQUIRE_AUTH=0
ExecStart=/usr/bin/python3 @PROJECT_DIR@/cvp_web.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

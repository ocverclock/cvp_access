[CVP_access]
    comment = CVP Access Git project
    path = @PROJECT_DIR@
    browseable = yes
    read only = no
    guest ok = no
    valid users = @CVP_USER@
    force user = @CVP_USER@
    create mask = 0664
    directory mask = 0775

[CVP_config]
    comment = CVP Access customer configuration
    path = @CONFIG_DIR@
    browseable = yes
    read only = no
    guest ok = no
    valid users = @CVP_USER@
    force user = @CVP_USER@
    create mask = 0660
    directory mask = 0770

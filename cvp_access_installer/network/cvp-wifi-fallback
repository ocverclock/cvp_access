#!/usr/bin/env bash
set -u

HOTSPOT="${CVP_HOTSPOT_NAME:-CVP-ACCESS}"
WAIT_SECONDS="${CVP_WIFI_FALLBACK_WAIT:-30}"

detect_wifi_device() {
    if [[ -n "${CVP_WIFI_DEVICE:-}" ]]; then
        printf '%s\n' "$CVP_WIFI_DEVICE"
        return
    fi

    local profile_dev=""
    profile_dev="$(nmcli -g connection.interface-name connection show "$HOTSPOT" 2>/dev/null || true)"
    if [[ -n "$profile_dev" ]] && nmcli -t -f DEVICE,TYPE device status 2>/dev/null |
        awk -F: -v dev="$profile_dev" '$1 == dev && $2 == "wifi" { found=1 } END { exit(found ? 0 : 1) }'; then
        printf '%s\n' "$profile_dev"
        return
    fi

    nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null |
        awk -F: '$2 == "wifi" && $3 != "unavailable" { print $1; exit }'
}

DEV="$(detect_wifi_device)"

log() {
    logger -t cvp-wifi "$*"
    printf '[cvp-wifi] %s\n' "$*"
}

# A normal network connection (Ethernet or Wi-Fi) always has priority over the
# maintenance hotspot. "Connected" here means NetworkManager considers the
# interface connected; Internet access is not required.
normal_network_active() {
    nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null |
        awk -F: -v hotspot="$HOTSPOT" '
            $1 != "lo" &&
            $3 == "connected" &&
            $4 != hotspot &&
            ($2 == "ethernet" || $2 == "wifi") {
                found = 1
            }
            END { exit(found ? 0 : 1) }
        '
}

hotspot_active() {
    nmcli -t -f NAME connection show --active 2>/dev/null |
        grep -Fxq "$HOTSPOT"
}

wifi_device_available() {
    nmcli -t -f DEVICE,TYPE device status 2>/dev/null |
        awk -F: -v dev="$DEV" '$1 == dev && $2 == "wifi" { found = 1 } END { exit(found ? 0 : 1) }'
}

while true; do
    if [[ -z "$DEV" ]] || ! wifi_device_available; then
        DEV="$(detect_wifi_device)"
    fi

    # Ethernet or a normal Wi-Fi connection is sufficient: do not start the AP.
    # If the AP was already active when a LAN connection appeared, stop it.
    if normal_network_active; then
        if hotspot_active; then
            log "Réseau normal actif : arrêt de $HOTSPOT"
            nmcli connection down "$HOTSPOT" >/dev/null 2>&1 || true
        fi
        sleep 15
        continue
    fi

    # If the maintenance hotspot is already providing access, keep it.
    if hotspot_active; then
        sleep 30
        continue
    fi

    # No usable Wi-Fi radio means there is nothing to turn into an AP.
    if ! wifi_device_available; then
        sleep 30
        continue
    fi

    sleep "$WAIT_SECONDS"

    # Re-check after the grace period: Ethernet/Wi-Fi may have come up meanwhile.
    if normal_network_active; then
        continue
    fi

    if ! hotspot_active; then
        log "Aucun réseau normal actif : démarrage de $HOTSPOT"
        if ! nmcli connection up "$HOTSPOT" ifname "$DEV"; then
            log "Échec du démarrage de $HOTSPOT ; nouvel essai dans 30 s"
        fi
    fi

    sleep 30
done
